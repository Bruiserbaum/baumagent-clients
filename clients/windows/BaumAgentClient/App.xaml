<Application
    x:Class="BaumAgent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide colour tokens -->
            <Color x:Key="BaumAccent">#3b82f6</Color>
            <Color x:Key="BaumSurface">#16213e</Color>
            <Color x:Key="BaumBackground">#0f172a</Color>
            <Color x:Key="BaumBorder">#1e3a5f</Color>
            <Color x:Key="BaumText">#e2e8f0</Color>
            <Color x:Key="BaumSubtext">#64748b</Color>
            <Color x:Key="BaumSuccess">#4ade80</Color>
            <Color x:Key="BaumDanger">#f87171</Color>
            <Color x:Key="BaumWarning">#f59e0b</Color>

            <SolidColorBrush x:Key="BaumAccentBrush" Color="{StaticResource BaumAccent}" />
            <SolidColorBrush x:Key="BaumSurfaceBrush" Color="{StaticResource BaumSurface}" />
            <SolidColorBrush x:Key="BaumBackgroundBrush" Color="{StaticResource BaumBackground}" />
            <SolidColorBrush x:Key="BaumBorderBrush" Color="{StaticResource BaumBorder}" />
            <SolidColorBrush x:Key="BaumTextBrush" Color="{StaticResource BaumText}" />
            <SolidColorBrush x:Key="BaumSubtextBrush" Color="{StaticResource BaumSubtext}" />
            <SolidColorBrush x:Key="BaumSuccessBrush" Color="{StaticResource BaumSuccess}" />
            <SolidColorBrush x:Key="BaumDangerBrush" Color="{StaticResource BaumDanger}" />
            <SolidColorBrush x:Key="BaumWarningBrush" Color="{StaticResource BaumWarning}" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BaumSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BaumBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#a3e635" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
