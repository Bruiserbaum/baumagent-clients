<Page
    x:Class="BaumAgent.Pages.TaskDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BaumBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description + status -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DescriptionText" Text="" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BaumTextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusText" Text="" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="TypeText" Text="" FontSize="13"
                               Foreground="{StaticResource BaumSubtextBrush}"/>
                    <TextBlock x:Name="ModelText" Text="" FontSize="13"
                               Foreground="{StaticResource BaumSubtextBrush}"/>
                </StackPanel>

                <!-- Progress bar (visible while running) -->
                <ProgressBar x:Name="ProgressBar" Grid.Row="2" Margin="0,10,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Foreground="{StaticResource BaumAccentBrush}"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
            <Button x:Name="RetryBtn" Content="↻ Re-run" Click="Retry_Click" IsEnabled="False"/>
            <Button x:Name="DownloadBtn" Content="⬇ Download export" Click="Download_Click" IsEnabled="False"/>
            <HyperlinkButton x:Name="PrLink" Content="" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Health scan fix banner (visible only for completed [Health Scan] tasks) -->
        <Border Grid.Row="2" x:Name="FixIssuesPanel" Visibility="Collapsed"
                Background="#1a0d2e" BorderBrush="#6d28d9" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Audit complete — grant permission to fix all found issues?"
                               Foreground="#c4b5fd" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="FixStatusText" Text="" Foreground="#94a3b8"
                               FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="FixIssuesBtn" Content="⚡ Fix Issues"
                        Click="FixIssues_Click" IsEnabled="True"
                        Background="#5b21b6" Foreground="#ede9fe"
                        BorderBrush="#7c3aed" BorderThickness="1"
                        Padding="16,8" FontWeight="Bold" CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Live log -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Style="{StaticResource MonoTextStyle}"
                           Padding="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Text="Connecting…"/>
            </ScrollViewer>
        </Border>

        <!-- Exports list (shown after completion if exports exist) -->
        <Border Grid.Row="4" x:Name="ExportsPanel" Visibility="Collapsed"
                Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Exports" FontWeight="SemiBold"
                           Foreground="{StaticResource BaumTextBrush}"/>
                <ListView x:Name="ExportsList" SelectionMode="None" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Filename}"
                                           Foreground="{StaticResource BaumTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                           Foreground="{StaticResource BaumSubtextBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                                <Button Grid.Column="2" Content="Download"
                                        Tag="{Binding}" Click="ExportDownload_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Page>
