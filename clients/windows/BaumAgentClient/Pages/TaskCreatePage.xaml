<Page
    x:Class="BaumAgent.Pages.TaskCreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BaumBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Spacing="16">

            <TextBlock Text="Create Task" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BaumTextBrush}"/>

            <!-- Description + voice input -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Description" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="DescriptionBox"
                             PlaceholderText="Describe the task…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="100"
                             Foreground="{StaticResource BaumTextBrush}"/>

                    <!-- Voice dictation -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                        <Button x:Name="VoiceBtn" Content="🎤 Dictate"
                                Click="Voice_Click"/>
                        <Button Content="Speech settings" Click="OpenSpeechSettings_Click"
                                Padding="8,4"
                                Foreground="{StaticResource BaumSubtextBrush}"/>
                        <TextBlock x:Name="VoiceStatus" Text=""
                                   VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="300"
                                   Foreground="{StaticResource BaumSubtextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Task type -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Task type" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Research" Tag="research" IsSelected="True"/>
                        <ComboBoxItem Content="Deep Research" Tag="deep_research"/>
                        <ComboBoxItem Content="Instructions (.docx)" Tag="instructions"/>
                        <ComboBoxItem Content="Script (local)" Tag="coding"/>
                        <ComboBoxItem Content="Code (GitHub)" Tag="code"/>
                        <ComboBoxItem Content="Structured Document" Tag="structured_document"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- LLM model -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="LLM model" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="claude-opus-4-6" IsSelected="True"/>
                        <ComboBoxItem Content="claude-sonnet-4-6"/>
                        <ComboBoxItem Content="claude-haiku-4-5-20251001"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Instructions options: OS + difficulty -->
            <Border x:Name="InstructionsOptions" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Target OS" FontWeight="SemiBold"
                                   Foreground="{StaticResource BaumTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Name="OsWindows" Content="Windows" IsChecked="True"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                            <CheckBox x:Name="OsMacOS" Content="macOS" IsChecked="True"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                            <CheckBox x:Name="OsLinux" Content="Linux"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Difficulty" FontWeight="SemiBold"
                                   Foreground="{StaticResource BaumTextBrush}"/>
                        <ComboBox x:Name="DifficultyBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Beginner" IsSelected="True"/>
                            <ComboBoxItem Content="Intermediate"/>
                            <ComboBoxItem Content="Advanced"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Code task: repo URL -->
            <Border x:Name="CodeOptions" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="Repository" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="RepoUrlBox" PlaceholderText="https://github.com/…"
                             Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="BaseBranchBox" PlaceholderText="Base branch (default: main)"
                             Text="main"
                             Foreground="{StaticResource BaumTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Submit -->
            <StackPanel Spacing="8">
                <Button x:Name="SubmitBtn" Content="Create task →"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="Submit_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24"/>
                    <TextBlock x:Name="ErrorText" Text="" VerticalAlignment="Center"
                               Foreground="{StaticResource BaumDangerBrush}" FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
