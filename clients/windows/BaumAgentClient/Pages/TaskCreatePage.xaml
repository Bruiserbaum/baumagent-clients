<Page
    x:Class="BaumAgent.Pages.TaskCreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BaumBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Spacing="16">

            <TextBlock Text="Create Task" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BaumTextBrush}"/>

            <!-- Description + voice input -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Description" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="DescriptionBox"
                             PlaceholderText="Describe the task…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="100"
                             Foreground="{StaticResource BaumTextBrush}"/>

                    <!-- Voice dictation -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                        <Button x:Name="VoiceBtn" Content="🎤 Dictate"
                                Click="Voice_Click"/>
                        <Button Content="Speech settings" Click="OpenSpeechSettings_Click"
                                Padding="8,4"
                                Foreground="{StaticResource BaumSubtextBrush}"/>
                        <TextBlock x:Name="VoiceStatus" Text=""
                                   VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="300"
                                   Foreground="{StaticResource BaumSubtextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Image attachments -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Image attachments" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBlock Text="Paste an image from the clipboard or browse for image files to include with the task."
                               FontSize="12" Foreground="{StaticResource BaumSubtextBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PasteImageBtn" Content="📋 Paste image"
                                Click="PasteImage_Click"/>
                        <Button x:Name="BrowseImageBtn" Content="📁 Browse…"
                                Click="BrowseImage_Click"/>
                    </StackPanel>
                    <ListView x:Name="ImageList" SelectionMode="None" Background="Transparent"
                              Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Thumbnail}" Width="40" Height="40"
                                           Stretch="UniformToFill" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Foreground="{StaticResource BaumTextBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               Foreground="{StaticResource BaumSubtextBrush}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="8,0"/>
                                    <Button Grid.Column="3" Content="✕"
                                            Tag="{Binding}" Click="RemoveImage_Click"
                                            Padding="6,2" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ImageStatus" Text="" FontSize="12"
                               Foreground="{StaticResource BaumSubtextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Task type -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Task type" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Research" Tag="research" IsSelected="True"/>
                        <ComboBoxItem Content="Deep Research" Tag="deep_research"/>
                        <ComboBoxItem Content="Instructions (.docx)" Tag="instructions"/>
                        <ComboBoxItem Content="Script (local)" Tag="coding"/>
                        <ComboBoxItem Content="Code (GitHub)" Tag="code"/>
                        <ComboBoxItem Content="Structured Document" Tag="structured_document"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- LLM model -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="LLM model" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="claude-opus-4-6" IsSelected="True"/>
                        <ComboBoxItem Content="claude-sonnet-4-6"/>
                        <ComboBoxItem Content="claude-haiku-4-5-20251001"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Project selector -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Project" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBlock Text="Assign this task to a project for organisation and tracking."
                               FontSize="12" Foreground="{StaticResource BaumSubtextBrush}"
                               TextWrapping="Wrap"/>
                    <ComboBox x:Name="ProjectBox" HorizontalAlignment="Stretch"
                              PlaceholderText="No project (default)">
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Delivery mode (research output options) -->
            <Border x:Name="DeliveryOptions" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Delivery mode" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBlock Text="Choose how the research output is delivered."
                               FontSize="12" Foreground="{StaticResource BaumSubtextBrush}"
                               TextWrapping="Wrap"/>
                    <ComboBox x:Name="DeliveryBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Document (.docx)" Tag="docx" IsSelected="True"/>
                        <ComboBoxItem Content="Markdown (.md)" Tag="markdown"/>
                        <ComboBoxItem Content="PDF (.pdf)" Tag="pdf"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Instructions options: OS + difficulty -->
            <Border x:Name="InstructionsOptions" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Target OS" FontWeight="SemiBold"
                                   Foreground="{StaticResource BaumTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox x:Name="OsWindows" Content="Windows" IsChecked="True"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                            <CheckBox x:Name="OsMacOS" Content="macOS" IsChecked="True"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                            <CheckBox x:Name="OsLinux" Content="Linux"
                                      Foreground="{StaticResource BaumTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Difficulty" FontWeight="SemiBold"
                                   Foreground="{StaticResource BaumTextBrush}"/>
                        <ComboBox x:Name="DifficultyBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Beginner" IsSelected="True"/>
                            <ComboBoxItem Content="Intermediate"/>
                            <ComboBoxItem Content="Advanced"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Code task: repo URL -->
            <Border x:Name="CodeOptions" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="Repository" FontWeight="SemiBold"
                               Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="RepoUrlBox" PlaceholderText="https://github.com/…"
                             Foreground="{StaticResource BaumTextBrush}"/>
                    <TextBox x:Name="BaseBranchBox" PlaceholderText="Base branch (default: main)"
                             Text="main"
                             Foreground="{StaticResource BaumTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Submit -->
            <StackPanel Spacing="8">
                <Button x:Name="SubmitBtn" Content="Create task →"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="Submit_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24"/>
                    <TextBlock x:Name="ErrorText" Text="" VerticalAlignment="Center"
                               Foreground="{StaticResource BaumDangerBrush}" FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
